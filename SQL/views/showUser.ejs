<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show all user</title>
    <style>
        table,
        th,
        tr,
        td {
            border: 2px solid rgb(36, 1, 42);
            padding: 5px;
            color: rgb(24, 0, 5);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        th {
            background-color: rgba(132, 152, 123, 0.784);
            position: sticky;
            top: 0;
        }

        th:hover {
            cursor: pointer;
            background-color: rgb(74, 63, 70);
            border: 2px solid #fff;
            color: #fff;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: all .5s;
        }

        tr:hover {
            cursor: pointer;
            /* background-color: rgb(74, 63, 70); */
            background-color: rgb(103, 104, 117);
            border: 2px solid #fff;
            color: #fff;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: all .5s;
        }

        td:hover {
            cursor: pointer;
            border: 2px solid #fff;
            background-color: rgb(103, 104, 117);
            color: #fff;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: all .5s;
        }

        table {
            width: 100%;
        }

        body {
            background-color: rgba(7, 0, 15, 0.438);
            overflow-x: hidden;
        }

        button {
            width: 100%;
            height: 100%;
            padding: 5px 10px;
            border: none;
            /* background-color: rgba(7, 0, 15, 0.438); */
            background: none;
        }

        button:hover {
            font-weight: bold;
            color: #fff;
            text-decoration: dotted;
            cursor: pointer;
        }

        .red {
            color: rgb(121, 2, 2);
        }
        form{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        form input{
            padding: 5px 10px;
            border-radius: 8px;
            border: red;
            box-shadow: inset 0px 0px 10px black;
        }
    </style>
</head>

<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Usernam</th>
            <th>Edit username</th>
            <th>Delete username</th>
        </tr>
        <%for(user of users){%>
            <tr>
                <td>
                    <%=user.id%>
                </td>
                <td>
                    <%=user.email%>
                </td>
                <td>
                    <%=user.username%>
                </td>
                <td>
                    <form action="/user/<%=user.id%>/edit" method="get">
                        <button>Edit username</button>
                    </form>
                </td>
                <td>
                    <form action="/user/<%= user.id %>?_method=DELETE" method="POST">
                        <input type="password" name="password" placeholder="Enter Password" required>
                        <button class="red" type="submit">Delete</button>
                    </form>
                </td>


            </tr>
            <%}%>
    </table>
</body>

</html>